<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Android Suite" verbose="2" parallel="tests" thread-count="2">

    <test name="Android_15 Test">
        <parameter name="device" value="Pixel_9_android_15"/>
        <parameter name="deviceOS" value="android"/>
        <parameter name="osVersion" value="15"/>
        <parameter name="port" value="4723" />
        <classes>
            <class name="LoginPageTest">
                <methods>
                    <include name="signInAsExistingUserTest"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Android_16 Test">
        <parameter name="device" value="Pixel_9_android_16"/>
        <parameter name="deviceOS" value="android"/>
        <parameter name="osVersion" value="16"/>
        <parameter name="port" value="4725"/>
        <classes>
            <class name="LoginPageTest">
                <methods>
                    <include name="signInAsExistingUserFailedTest"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>